# Copia este archivo como ".env" y ajusta los valores a tu entorno local.

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=said
DB_USER=postgres
DB_PASSWORD=postgres

# --- Seguridad ---
# Genera una clave propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-tuya
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS: URL(s) del frontend, separadas por coma ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
